{
  "name": "code-to-video",
  "version": "0.1.0",
  "description": "Tech topic in, studio-style animated explainer video out, for $0. Voice, captions, music, motion graphics and 3D, rendered locally with free open-source tools.",
  "type": "module",
  "bin": {
    "c2v": "bin/c2v.mjs"
  },
  "scripts": {
    "make": "node bin/c2v.mjs make",
    "demo": "node bin/c2v.mjs make examples/what-is-docker.json",
    "doctor": "node bin/c2v.mjs doctor",
    "themes": "node bin/c2v.mjs themes"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
